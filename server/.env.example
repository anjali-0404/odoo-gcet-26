# Copy this file to server/.env and fill in real values. Never commit .env.

# Port the API listens on
PORT=5000

# development | production
NODE_ENV=development

# MongoDB Atlas connection string (Atlas clusters are replica sets, which
# the stock service needs for transactions). Remember to allow your IP in
# Atlas -> Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stocksense?retryWrites=true&w=majority

# Allowed CORS origin(s) for the frontend. Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# JWT settings. Use a long random string for the secret.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Password-reset OTP lifetime in minutes
OTP_TTL_MINUTES=10

# Demo helper: when true (and NODE_ENV is not production) the forgot-password
# response includes the OTP so the flow works without email.
OTP_DEV_RESPONSE=true

# Optional SMTP for sending OTP emails. If SMTP_HOST is empty the OTP is
# printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StockSense <no-reply@stocksense.local>
